    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "css-loader": "^7.1.2",
    "jsdom": "^26.1.0",
    "style-loader": "^4.0.0",
    "svg-url-loader": "^8.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "~5.7.2",
    "vitest": "^3.1.4",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1"
  },
  "resolutions": {
    "minimatch@npm:^9.0.4": "npm:^9.0.9",
